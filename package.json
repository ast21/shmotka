{
  "name": "shmotka",
  "version": "0.2.1",
  "description": "Шмотка — тема daisyUI и шпаргалка готовых фрагментов для личных проектов: общий вид, под проект меняется только акцент.",
  "private": true,
  "type": "module",
  "repository": "github:ast21/shmotka",
  "style": "package/css/shmotka.css",
  "exports": {
    ".": {
      "style": "./package/css/shmotka.css",
      "default": "./package/css/shmotka.css"
    },
    "./telegram": "./package/js/telegram.js",
    "./tokens.json": "./package/tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "package"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "showcase": "node showcase/build.mjs",
    "check": "bash scripts/check.sh"
  },
  "peerDependencies": {
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3"
  }
}
