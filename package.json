{
  "name": "shmotka",
  "version": "0.5.0",
  "description": "Shmotka — тема daisyUI и шпаргалка готовых фрагментов для личных проектов: общий вид, под проект меняется только акцент.",
  "private": true,
  "type": "module",
  "repository": "github:ast21/shmotka",
  "style": "css/shmotka.css",
  "exports": {
    ".": {
      "style": "./css/shmotka.css",
      "default": "./css/shmotka.css"
    },
    "./fonts": {
      "style": "./css/fonts.css",
      "default": "./css/fonts.css"
    },
    "./fonts/*": "./fonts/*",
    "./telegram": "./js/telegram.js",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "shmotka-fonts": "bin/shmotka-fonts.mjs"
  },
  "files": [
    "css",
    "fonts",
    "bin",
    "js",
    "tokens",
    "snippets",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "showcase": "node showcase/build.mjs",
    "check": "bash scripts/check.sh"
  },
  "peerDependencies": {
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3"
  }
}
