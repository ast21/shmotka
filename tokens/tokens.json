{
  "name": "Шмотка",
  "about": "Единственный источник токенов. Из него scripts/build.mjs собирает css/shmotka.css, а scripts/check-contrast.mjs проверяет контраст. Значения перенесены из прототипа дизайн-системы (артефакт «l80 UI»).",

  "accent": {
    "about": "Акцент проекта. Проект задаёт --shm-accent (и по желанию --shm-accent-light для светлой темы) — остальное выводится само.",
    "default": "ideahub",
    "presets": {
      "ideahub": { "name": "IdeaHub, фиолетовый", "dark": "#8b7dff", "light": "#5b4bdb" },
      "iskra":   { "name": "Искра, синий",        "dark": "#5aa9ff", "light": "#1f74ba" },
      "finance": { "name": "Личные финансы, бирюзовый", "dark": "#3ccfb4", "light": "#0f7f6c" }
    },
    "lightFromDark": { "mix": "accent", "percent": 72, "with": "#000000", "about": "Светлый вариант акцента, если проект задал только --shm-accent." }
  },

  "themes": {
    "dark": {
      "name": "shmotka-dark",
      "colorScheme": "dark",
      "default": false,
      "prefersdark": true,
      "colors": {
        "bg":            { "value": "#0d0f14", "daisy": "base-100", "usage": "Фон страницы. Тёмная тема — основа системы." },
        "surface":       { "value": "#12151d", "daisy": "base-200", "usage": "Карточки, панели, таблицы, модальные окна." },
        "surface-2":     { "value": "#1a1e2a", "daisy": "base-300", "usage": "Вложенный уровень: строка при наведении, дорожка прогресса, поле поиска." },
        "fg":            { "value": "#e7e9f0", "daisy": "base-content", "usage": "Основной текст." },
        "fg-muted":      { "value": "#9097a8", "usage": "Подписи, метаданные, плейсхолдеры." },
        "fg-subtle":     { "value": "#6b7186", "usage": "Только декор: номера строк, иконки-подсказки. Не для смыслового текста." },
        "border":        { "value": "#1e2230", "usage": "Тонкие разделители и рамки карточек." },
        "border-strong": { "value": "#2c3244", "usage": "Рамки полей и вторичных кнопок." },
        "neutral":       { "value": "#2c3244", "daisy": "neutral", "usage": "Нейтральная заливка (btn-neutral)." },
        "neutral-fg":    { "value": "#e7e9f0", "daisy": "neutral-content", "usage": "Текст на neutral." },
        "on-color":      { "value": "#0d0f14", "usage": "Текст на заливке акцента и семантических цветов." },
        "success":       { "value": "#53d18b", "daisy": "success", "usage": "Готово, успех, версия выпущена." },
        "success-soft":  { "value": "#12291c", "usage": "Подложка успеха." },
        "warning":       { "value": "#f2b84b", "daisy": "warning", "usage": "В работе, внимание." },
        "warning-soft":  { "value": "#2e2410", "usage": "Подложка предупреждения." },
        "danger":        { "value": "#ff6b6b", "daisy": "error", "usage": "Ошибка, удаление, просрочка." },
        "danger-soft":   { "value": "#33181a", "usage": "Подложка ошибки." },
        "info":          { "value": "#5aa9f0", "daisy": "info", "usage": "Запланировано, справка." },
        "info-soft":     { "value": "#13253a", "usage": "Подложка подсказки." },
        "status-idea":   { "value": "#8a91a3", "usage": "Статус «Идея»." },
        "heat-0":        { "value": "#1a1e2a", "usage": "Карта активности: пустой день." },
        "heat-1":        { "value": "#0e4429", "usage": "Карта активности: мало." },
        "heat-2":        { "value": "#006d32", "usage": "Карта активности: средне." },
        "heat-3":        { "value": "#26a641", "usage": "Карта активности: много." },
        "heat-4":        { "value": "#39d353", "usage": "Карта активности: максимум." },
        "overlay":       { "value": "#05060acc", "usage": "Затемнение под модальным окном." }
      },
      "derived": {
        "primary-fg":   { "value": "#0d0f14", "usage": "Текст на заливке акцента." },
        "primary-soft": { "mix": "primary", "percent": 18, "with": "bg", "usage": "Мягкая подложка акцента: выбранный чип, активный пункт." },
        "primary-text": { "mix": "primary", "percent": 65, "with": "#ffffff", "usage": "Ссылки и акцентный текст." }
      },
      "shadows": {
        "shadow-sm": "0 1px 0 #00000066",
        "shadow-lg": "0 24px 48px -12px #000000b3"
      }
    },
    "light": {
      "name": "shmotka-light",
      "colorScheme": "light",
      "default": true,
      "prefersdark": false,
      "colors": {
        "bg":            { "value": "#f6f7fa", "daisy": "base-100" },
        "surface":       { "value": "#ffffff", "daisy": "base-200" },
        "surface-2":     { "value": "#eef0f5", "daisy": "base-300" },
        "fg":            { "value": "#12151d", "daisy": "base-content" },
        "fg-muted":      { "value": "#5a6175" },
        "fg-subtle":     { "value": "#8a91a3" },
        "border":        { "value": "#e1e4ec" },
        "border-strong": { "value": "#c9ceda" },
        "neutral":       { "value": "#12151d", "daisy": "neutral" },
        "neutral-fg":    { "value": "#f6f7fa", "daisy": "neutral-content" },
        "on-color":      { "value": "#ffffff" },
        "success":       { "value": "#176f3d", "daisy": "success" },
        "success-soft":  { "value": "#e6f5ec" },
        "warning":       { "value": "#965700", "daisy": "warning" },
        "warning-soft":  { "value": "#fcf2de" },
        "danger":        { "value": "#b92b27", "daisy": "error" },
        "danger-soft":   { "value": "#fce8e7" },
        "info":          { "value": "#1b64a8", "daisy": "info" },
        "info-soft":     { "value": "#eaf2fb" },
        "status-idea":   { "value": "#6b7286" },
        "heat-0":        { "value": "#eef0f5" },
        "heat-1":        { "value": "#9be9a8" },
        "heat-2":        { "value": "#40c463" },
        "heat-3":        { "value": "#30a14e" },
        "heat-4":        { "value": "#216e39" },
        "overlay":       { "value": "#12151d66" }
      },
      "derived": {
        "primary-fg":   { "value": "#ffffff" },
        "primary-soft": { "mix": "primary", "percent": 12, "with": "#ffffff" },
        "primary-text": { "mix": "primary", "percent": 88, "with": "#000000" }
      },
      "shadows": {
        "shadow-sm": "0 1px 2px #12151d14",
        "shadow-lg": "0 24px 48px -16px #12151d40"
      }
    }
  },

  "contrast": {
    "about": "Пары «текст — фон», которые проверяются в обеих темах и для каждого пресета акцента. text — 4.5:1, ui (рамки полей, кольцо фокуса, сама заливка акцента) — 3:1.",
    "text": [
      ["fg", "bg"], ["fg", "surface"], ["fg", "surface-2"],
      ["fg-muted", "bg"], ["fg-muted", "surface"], ["fg-muted", "surface-2"],
      ["neutral-fg", "neutral"],
      ["primary-fg", "primary"],
      ["primary-text", "bg"], ["primary-text", "surface"], ["primary-text", "primary-soft"],
      ["on-color", "success"], ["on-color", "warning"], ["on-color", "danger"], ["on-color", "info"],
      ["success", "success-soft"], ["warning", "warning-soft"], ["danger", "danger-soft"], ["info", "info-soft"],
      ["success", "surface"], ["warning", "surface"], ["danger", "surface"], ["info", "surface"],
      ["status-idea", "surface"]
    ],
    "ui": [
      ["primary", "bg"], ["primary", "surface"]
    ]
  },

  "fonts": {
    "display": "\"Space Grotesk\", Inter, system-ui, sans-serif",
    "sans": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
  },

  "radius": {
    "sm":   { "value": "6px",   "usage": "Теги, сегменты прогресса, чекбоксы." },
    "md":   { "value": "10px",  "usage": "Кнопки, поля." },
    "lg":   { "value": "14px",  "usage": "Карточки и панели." },
    "xl":   { "value": "22px",  "usage": "Крупные карточки на телефоне (как в Искре), модальные окна." },
    "pill": { "value": "999px", "usage": "Бейджи статусов, чипы фильтров." }
  },

  "daisy": {
    "about": "Параметры формы компонентов daisyUI. Без data-theme тема следует системной настройке: светлая по умолчанию, тёмная при prefers-color-scheme: dark.",
    "radius-selector": "{radius.sm}",
    "radius-field": "{radius.md}",
    "radius-box": "{radius.lg}",
    "size-selector": "0.25rem",
    "size-field": "0.25rem",
    "border": "1px",
    "depth": "0",
    "noise": "0"
  },

  "size": {
    "sidebar-w":   { "value": "240px",  "usage": "Ширина бокового меню и оглавления." },
    "panel-w":     { "value": "340px",  "usage": "Ширина правой панели." },
    "content-max": { "value": "1200px", "usage": "Максимальная ширина контента." }
  }
}
